---
import LogoMark from './LogoMark.astro';
import LangSwitch from './LangSwitch.astro';
import { useCopy } from '../i18n';
import { localePath, splitLocalePath, type LocaleCode } from '../i18n/config';
import { SITE } from '../lib/site';

interface Props {
  lang: LocaleCode;
}
const { lang } = Astro.props;
const t = useCopy(lang);
const home = localePath(lang, '/');
const links = [
  { href: `${home}#how`, label: t.ui.how },
  { href: localePath(lang, '/security'), label: t.ui.security },
  { href: `${home}#pricing`, label: t.ui.pricing },
  { href: `${home}#faq`, label: t.ui.faq },
];
const path = localePath(lang, splitLocalePath(Astro.url.pathname).path);
---
<header class="border-b border-border bg-background">
  <div class="wrap flex flex-wrap items-center gap-x-6 gap-y-0 py-2.5 lg:py-3.5">
    <a href={home} class="order-1 flex min-h-11 items-center gap-2 no-underline" aria-label={t.ui.logoLabel}>
      <LogoMark width={30} />
      <span class="font-serif text-[25px] leading-none" aria-hidden="true">
        <span class="text-leaf">Use</span> <span class="font-medium text-wordmark">Sybil</span>
      </span>
    </a>
    <nav aria-label={t.ui.siteNav} class="order-3 w-full lg:order-2 lg:w-auto">
      <ul class="m-0 flex list-none flex-wrap gap-x-5 p-0 text-[15px] lg:gap-x-[22px]">
        {links.map((l) => (
          <li>
            <a
              href={l.href}
              class="inline-flex min-h-11 items-center text-foreground no-underline hover:underline"
              aria-current={l.href === path ? 'page' : undefined}
            >
              {l.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
    <div class="order-2 ml-auto flex items-center gap-4 text-sm lg:order-3">
      <LangSwitch current={lang} class="hidden md:flex" />
      <a href={SITE.signInUrl} class="inline-flex min-h-11 items-center text-foreground no-underline hover:underline">{t.ui.signIn}</a>
      <a href={SITE.registerUrl} class="btn btn-sm">{t.ui.tryFree}</a>
    </div>
  </div>
</header>
