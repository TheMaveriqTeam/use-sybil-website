---
/** Top of a sub-page: visible breadcrumb, eyebrow, the page's one h1, lead. */
import { useCopy } from '../i18n';
import { localePath, type LocaleCode } from '../i18n/config';

interface Props {
  lang: LocaleCode;
  eyebrow: string;
  title: string;
  lead?: string;
  crumb: string;
  badge?: string;
}
const { lang, eyebrow, title, lead, crumb, badge } = Astro.props;
const t = useCopy(lang);
---
<section class="border-b border-border pt-6 pb-12 md:pb-16">
  <div class="wrap">
    <nav aria-label={t.ui.breadcrumb} class="text-sm text-muted-foreground">
      <ol class="m-0 flex list-none flex-wrap items-center gap-2 p-0">
        <li><a href={localePath(lang, '/')} class="inline-flex min-h-11 items-center text-muted-foreground">{t.ui.home}</a></li>
        <li aria-hidden="true">›</li>
        <li aria-current="page" class="text-foreground">{crumb}</li>
      </ol>
    </nav>
    <div class="mt-6 max-w-[760px] md:mt-10">
      <p class="eyebrow m-0 flex items-center gap-3">
        {eyebrow}
        {badge && <span class="rounded-sm border border-dashed border-placeholder-border px-2 py-0.5 text-[11px] tracking-[0.08em] text-muted-foreground">{badge}</span>}
      </p>
      <h1 class="mt-3 mb-0 font-serif text-[clamp(40px,5.4vw,64px)] leading-[1.02] font-normal text-balance">{title}</h1>
      {lead && <p class="lead mt-5 mb-0 max-w-[640px]">{lead}</p>}
      <slot />
    </div>
  </div>
</section>
